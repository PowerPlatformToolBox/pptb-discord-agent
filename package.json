{
  "name": "pptb-discord-assistant",
  "version": "1.0.0",
  "description": "Discord bot with GitHub integration for Power Platform ToolBox",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "deploy-commands": "node dist/scripts/deployCommands.js",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts",
    "format:check": "prettier --check src/**/*.ts",
    "type-check": "tsc --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "discord",
    "bot",
    "github",
    "powerplatform",
    "typescript"
  ],
  "author": "PowerPlatformToolBox",
  "license": "GPL-3.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.18.3"
  },
  "packageManager": "pnpm@10.18.3",
  "dependencies": {
    "discord.js": "^14.16.3",
    "dotenv": "^18.0.6",
    "winston": "^3.17.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
