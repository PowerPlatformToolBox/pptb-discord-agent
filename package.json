{
  "name": "pptb-discord-assistant",
  "version": "2.0.0",
  "description": "PPTB Agent - Discord notifications and slash commands for Power Platform ToolBox, hosted on Vercel",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/dev/server.ts",
    "deploy-commands": "tsx --env-file-if-exists=.env src/scripts/deployCommands.ts",
    "send-test-event": "tsx --env-file-if-exists=.env src/scripts/sendTestEvent.ts",
    "lint": "eslint src api tests jest.config.ts",
    "format": "prettier --write \"{src,api,tests}/**/*.ts\" jest.config.ts",
    "format:check": "prettier --check \"{src,api,tests}/**/*.ts\" jest.config.ts",
    "type-check": "tsc --noEmit",
    "test": "jest"
  },
  "keywords": [
    "discord",
    "bot",
    "github",
    "powerplatform",
    "typescript"
  ],
  "author": "PowerPlatformToolBox",
  "license": "GPL-3.0",
  "engines": {
    "node": "24.x",
    "pnpm": ">=10.18.3"
  },
  "packageManager": "pnpm@10.18.3",
  "dependencies": {
    "@vercel/functions": "^3.10.1",
    "discord-api-types": "^0.38.56",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.2.0",
    "@types/node": "^24.0.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "jest": "^30.2.0",
    "prettier": "^3.4.2",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1"
  }
}
