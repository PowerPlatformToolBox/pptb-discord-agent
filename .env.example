# Discord Configuration
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_GUILD_ID=your_test_guild_id_here

# GitHub Configuration
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_ORG=PowerPlatformToolBox

# Webhook Configuration
WEBHOOK_PORT=3000
WEBHOOK_SECRET=your_github_webhook_secret_here
# Shared secret pptb-web uses to sign POST /pptb-events (channel and role IDs live in src/config/notifications.ts)
PPTB_EVENTS_SECRET=your_pptb_events_secret_here
PROJECT_THREAD_CHANNEL_ID=your_project_discussion_channel_id
RELEASE_CHANNEL_ID=your_release_announcement_channel_id
# Voice channel ID renamed with the GitHub star count
STARS_VOICE_CHANNEL_ID=your_stars_voice_channel_id_here
# Comma-separated list of repositories to watch for releases
WATCHED_REPOSITORIES=desktop-app
# Comma-separated list of labels to watch for project item webhooks
# NOTE: This replaces the old PROJECT_DISCUSSION_LABEL variable
WATCHED_LABELS=DiscordDiscussion

# Environment
NODE_ENV=development
LOG_LEVEL=debug
ENABLE_FILE_LOGS=false
LOG_DIR=./logs
