# PPTB Agent - environment variables
# Copy to .env for local development (`cp .env.example .env`), or pull from Vercel with
# `vercel env pull .env`. Never commit .env. Setup guide: docs/DISCORD_SETUP.md

# --- Discord application (Developer Portal > your app) ---
# Bot > Reset Token
DISCORD_BOT_TOKEN=
# General Information > Application ID
DISCORD_CLIENT_ID=
# General Information > Public Key (64 hex characters)
DISCORD_PUBLIC_KEY=
# Right-click the server icon > Copy Server ID (Developer Mode must be on)
DISCORD_GUILD_ID=

# --- Discord channels (right-click channel > Copy Channel ID) ---
# Private staff channel: submissions, verification queue, update failures
DISCORD_CHANNEL_ADMIN=
# Public channel: tool approvals, updates, deprecations, verified tools
DISCORD_CHANNEL_TOOLS=
# Public channel: stable PPTB and VS Code extension releases
DISCORD_CHANNEL_RELEASES=
# Public channel: PPTB insider (pre-release) builds
DISCORD_CHANNEL_INSIDER=
# Text or forum-style text channel where GitHub discussion threads are created
DISCORD_CHANNEL_DISCUSSIONS=
# Voice channel renamed to the star count, e.g. "⭐ 1234"
DISCORD_CHANNEL_STARS=

# --- GitHub ---
# Fine-grained token: Issues read/write + Metadata read on the org repositories
GITHUB_TOKEN=
GITHUB_ORG=PowerPlatformToolBox
# Same value as the "Secret" field of the GitHub webhook
GITHUB_WEBHOOK_SECRET=
# Repository whose star count is shown in DISCORD_CHANNEL_STARS
STARS_REPOSITORY=desktop-app
# Comma-separated labels that create a Discord discussion thread when added to an issue/PR
WATCHED_LABELS=DiscordDiscussion

# --- Shared secrets (generate each with: openssl rand -hex 32) ---
# Shared with pptb-web and tool-management to sign POST /api/events
PLATFORM_EVENTS_SECRET=
# Vercel sends this as "Authorization: Bearer <CRON_SECRET>" to the daily cron job
CRON_SECRET=

# --- Optional ---
# debug | info | warn | error (default: info)
LOG_LEVEL=info
# Turn notifications off without a code change. Keys, category wildcards or "*".
# Example: DISABLED_NOTIFICATIONS=verify.assigned,tool.manual-update,github.*
DISABLED_NOTIFICATIONS=
# Send a notification to a different channel. Values are channel aliases
# (admin, tools, releases, insider, discussions, stars) or raw channel IDs.
# Example: NOTIFICATION_ROUTES=verify.approved=releases,tool.update=123456789012345678
NOTIFICATION_ROUTES=
